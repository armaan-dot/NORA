{
  "name": "nora-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/fetch-yolox.mjs && node scripts/build-nlu-model.mjs && vite",
    "build": "node scripts/fetch-yolox.mjs && node scripts/build-nlu-model.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "build:nlu": "node scripts/build-nlu-model.mjs",
    "train:vision": "node scripts/train-vision.mjs",
    "export:gazebo": "esbuild scripts/export-gazebo-models.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/export-gazebo-models.mjs --log-level=warning && node node_modules/.cache/export-gazebo-models.mjs",
    "test:physics": "esbuild scripts/physics-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/physics-test.mjs --log-level=warning && node node_modules/.cache/physics-test.mjs",
    "test:placement": "esbuild scripts/placement-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/placement-check.mjs --log-level=warning && node node_modules/.cache/placement-check.mjs",
    "test:scenarios": "esbuild scripts/scenario-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/scenario-check.mjs --log-level=warning && node node_modules/.cache/scenario-check.mjs",
    "test:sensors": "esbuild scripts/tactile-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/tactile-check.mjs --log-level=warning && node node_modules/.cache/tactile-check.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "lucide-react": "^0.469.0",
    "onnxruntime-web": "1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "roslib": "^2.1.0",
    "three": "^0.170.0",
    "urdf-loader": "^0.12.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/roslib": "^1.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.7"
  }
}
