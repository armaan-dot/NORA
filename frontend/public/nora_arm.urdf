<?xml version="1.0"?>
<robot name="nora_arm">
  <!-- Material Definitions -->
  <material name="dark_grey">
    <color rgba="0.2 0.22 0.25 1.0"/>
  </material>
  <material name="cyan_accent">
    <color rgba="0.0 0.94 1.0 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.45 0.0 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.75 0.75 0.8 1.0"/>
  </material>

  <!-- Base Link: Mount on table -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.08"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 1: Base Yaw -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child  link="link1"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="150.0" velocity="1.5"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.14"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.14"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 2: Shoulder Pitch -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child  link="link2"/>
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="150.0" velocity="1.5"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.07 0.32"/>
      </geometry>
      <material name="cyan_accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.07 0.32"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 3: Elbow Pitch -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child  link="link3"/>
    <origin xyz="0 0 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.3562" upper="2.3562" effort="100.0" velocity="1.5"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.18"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.18"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 4: Forearm Roll -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child  link="link4"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="100.0" velocity="1.0"/>
  </joint>

  <link name="link4">
    <visual>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.14"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.14"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 5: Wrist Pitch -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child  link="link5"/>
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100.0" velocity="1.0"/>
  </joint>

  <link name="link5">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.10"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.10"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 6: Wrist Roll -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child  link="link6"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="100.0" velocity="1.0"/>
  </joint>

  <link name="link6">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.06"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- Gripper Joint -->
  <joint name="gripper_joint" type="prismatic">
    <parent link="link6"/>
    <child  link="gripper_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.08" effort="50.0" velocity="0.5"/>
  </joint>

  <!-- Gripper Palm Link -->
  <link name="gripper_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.04 0.06"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.04 0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- Left Finger -->
  <joint name="left_finger_joint" type="fixed">
    <parent link="gripper_link"/>
    <child link="left_finger_link"/>
    <origin xyz="-0.03 0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="left_finger_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.025 0.05"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.025 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Right Finger -->
  <joint name="right_finger_joint" type="fixed">
    <parent link="gripper_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0.03 0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="right_finger_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.025 0.05"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.025 0.05"/>
      </geometry>
    </collision>
  </link>
</robot>

