<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nora_bt_executor</name>
  <version>0.1.0</version>
  <description>
    BehaviorTree.CPP executor for NORA. Turns a planner-generated skill
    sequence into a behavior tree, runs the skills as asynchronous ROS 2
    actions, and reports structured failures for replanning.
  </description>

  <maintainer email="nora@example.com">NORA Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <depend>nora_interfaces</depend>
  <depend>behaviortree_cpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
