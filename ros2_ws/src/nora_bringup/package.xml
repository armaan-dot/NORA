<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nora_bringup</name>
  <version>0.1.0</version>
  <description>
    Top-level launch and configuration package for NORA.
    Provides launch files for simulation, full-stack, and demo scenarios.
  </description>

  <maintainer email="nora@example.com">NORA Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime deps — every nora sub-package -->
  <exec_depend>nora_skills</exec_depend>
  <exec_depend>nora_skills_cpp</exec_depend>
  <exec_depend>nora_orchestrator</exec_depend>
  <exec_depend>nora_perception</exec_depend>
  <exec_depend>nora_interfaces</exec_depend>
  <exec_depend>nora_description</exec_depend>
  <exec_depend>nora_gazebo</exec_depend>
  <exec_depend>nora_control</exec_depend>
  <exec_depend>nora_moveit_config</exec_depend>
  <exec_depend>nora_nlu</exec_depend>
  <exec_depend>nora_affordance</exec_depend>
  <exec_depend>nora_core</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
