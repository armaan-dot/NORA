<?xml version="1.0" ?>
<!--
  tabletop.world — Gazebo Classic world for NORA manipulation experiments.

  Contents:
    - Ground plane
    - Sun (directional light)
    - Table (static box model at z=0.375, top surface at z=0.75)
    - red_cube     (0.05 m box, on the table)
    - blue_cylinder (0.04 m radius × 0.08 m height, on the table)
    - green_sphere  (0.04 m radius, on the table)
-->
<sdf version="1.6">
  <world name="tabletop">

    <!-- ================================================================
         Physics
    ================================================================ -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ================================================================
         Plugins
    ================================================================ -->
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>
    <plugin name="gazebo_ros_state"   filename="libgazebo_ros_state.so"/>

    <!-- ================================================================
         Lighting
    ================================================================ -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ================================================================
         Ground Plane
    ================================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         Table  (0.8 m × 1.4 m × 0.75 m high; static)
    ================================================================ -->
    <model name="table">
      <static>true</static>
      <pose>0.6 0 0.375 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>20.0</mass>
          <inertia>
            <ixx>1.0</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.0</iyy><iyz>0</iyz><izz>1.0</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.8 1.4 0.75</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.8 1.4 0.75</size></box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         red_cube  (0.05 m box, resting on table top at z=0.775)
    ================================================================ -->
    <model name="red_cube">
      <pose>0.55 -0.15 0.775 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>4.166e-5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>4.166e-5</iyy><iyz>0</iyz><izz>4.166e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
          <surface>
            <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         blue_cylinder  (r=0.04 m, h=0.08 m, on table at z=0.79)
    ================================================================ -->
    <model name="blue_cylinder">
      <pose>0.60 0.10 0.79 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>1.067e-4</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.067e-4</iyy><iyz>0</iyz><izz>1.2e-4</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.04</radius><length>0.08</length></cylinder>
          </geometry>
          <surface>
            <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.04</radius><length>0.08</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.2 0.9 1</ambient>
            <diffuse>0.1 0.2 0.9 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         green_sphere  (r=0.04 m, on table at z=0.79)
    ================================================================ -->
    <model name="green_sphere">
      <pose>0.70 -0.05 0.79 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>5.12e-5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>5.12e-5</iyy><iyz>0</iyz><izz>5.12e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.04</radius></sphere>
          </geometry>
          <surface>
            <friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere><radius>0.04</radius></sphere>
          </geometry>
          <material>
            <ambient>0.1 0.8 0.1 1</ambient>
            <diffuse>0.1 0.8 0.1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
