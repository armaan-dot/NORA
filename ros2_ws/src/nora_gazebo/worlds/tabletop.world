<?xml version="1.0" ?>
<!--
  tabletop.world — Gazebo Classic world for NORA manipulation experiments.

  Contents:
    - Ground plane
    - Sun (directional light)
    - Table (same as the web simulator: 1.3 m × 0.9 m top, surface at z=0.45)
      The arm base sits on the table top at world (0, 0, 0.45), see world_to_base
      in nora_arm.urdf.xacro; the table centre is at (0.35, -0.05).
    - the objects of GAZEBO_SCENE in frontend/src/sim/objectLibrary.ts (models/,
      generated with the web simulator's meshes and physics)
    - overhead_camera (beyond the far edge at +x, 1.1 m from the table-top
      centre, looking back at it 55 degrees below horizontal)
-->
<sdf version="1.6">
  <world name="tabletop">

    <!-- ================================================================
         Physics
    ================================================================ -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ================================================================
         Plugins
    ================================================================ -->
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>
    <plugin name="gazebo_ros_state"   filename="libgazebo_ros_state.so"/>

    <!-- ================================================================
         Lighting
    ================================================================ -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ================================================================
         Ground Plane
    ================================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         Table  (1.3 m × 0.9 m × 0.03 m top on 40 mm legs, surface at
         z=0.45; static; matches the web simulator's workbench)
    ================================================================ -->
    <model name="table">
      <static>true</static>
      <pose>0.35 -0.05 0 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>20.0</mass>
          <inertia>
            <ixx>1.0</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.0</iyy><iyz>0</iyz><izz>1.0</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0.435 0 0 0</pose>
          <geometry>
            <box><size>1.3 0.9 0.03</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.435 0 0 0</pose>
          <geometry>
            <box><size>1.3 0.9 0.03</size></box>
          </geometry>
          <material>
            <ambient>0.53 0.54 0.53 1</ambient>
            <diffuse>0.53 0.54 0.53 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="leg_fl_collision">
          <pose>0.6 0.4 0.21 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.42</size></box></geometry>
        </collision>
        <visual name="leg_fl">
          <pose>0.6 0.4 0.21 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.42</size></box></geometry>
          <material>
            <ambient>0.73 0.74 0.76 1</ambient>
            <diffuse>0.73 0.74 0.76 1</diffuse>
          </material>
        </visual>
        <collision name="leg_fr_collision">
          <pose>0.6 -0.4 0.21 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.42</size></box></geometry>
        </collision>
        <visual name="leg_fr">
          <pose>0.6 -0.4 0.21 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.42</size></box></geometry>
          <material>
            <ambient>0.73 0.74 0.76 1</ambient>
            <diffuse>0.73 0.74 0.76 1</diffuse>
          </material>
        </visual>
        <collision name="leg_bl_collision">
          <pose>-0.6 0.4 0.21 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.42</size></box></geometry>
        </collision>
        <visual name="leg_bl">
          <pose>-0.6 0.4 0.21 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.42</size></box></geometry>
          <material>
            <ambient>0.73 0.74 0.76 1</ambient>
            <diffuse>0.73 0.74 0.76 1</diffuse>
          </material>
        </visual>
        <collision name="leg_br_collision">
          <pose>-0.6 -0.4 0.21 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.42</size></box></geometry>
        </collision>
        <visual name="leg_br">
          <pose>-0.6 -0.4 0.21 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.42</size></box></geometry>
          <material>
            <ambient>0.73 0.74 0.76 1</ambient>
            <diffuse>0.73 0.74 0.76 1</diffuse>
          </material>
        </visual>
        <!-- robot mounting plate under the arm base (world 0, 0) -->
        <visual name="mount_plate">
          <pose>-0.35 0.05 0.448 0 0 0</pose>
          <geometry><box><size>0.24 0.24 0.006</size></box></geometry>
          <material>
            <ambient>0.56 0.57 0.59 1</ambient>
            <diffuse>0.56 0.57 0.59 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- BEGIN objects: generated by frontend/scripts/export-gazebo-models.ts from objectLibrary.ts -->
    <include>
      <uri>model://mug</uri>
      <name>mug</name>
      <pose>0.6300 -0.1500 0.4925 0 0 0.0000</pose>
    </include>
    <include>
      <uri>model://glass</uri>
      <name>glass</name>
      <pose>0.4700 -0.0500 0.5050 0 0 0.0000</pose>
    </include>
    <include>
      <uri>model://tennis_ball</uri>
      <name>tennis_ball</name>
      <pose>0.2500 -0.1900 0.4835 0 0 0.0000</pose>
    </include>
    <include>
      <uri>model://apple</uri>
      <name>apple</name>
      <pose>0.4000 0.1200 0.4827 0 0 0.0000</pose>
    </include>
    <include>
      <uri>model://can</uri>
      <name>can</name>
      <pose>0.5800 0.1000 0.4950 0 0 0.0000</pose>
    </include>
    <include>
      <uri>model://notebook</uri>
      <name>notebook</name>
      <pose>0.3200 -0.3600 0.4590 0 0 0.0000</pose>
    </include>
    <include>
      <uri>model://sponge</uri>
      <name>sponge</name>
      <pose>0.4500 -0.1900 0.4650 0 0 0.0000</pose>
    </include>
    <!-- END objects -->

    <model name="overhead_camera">
      <static>true</static>
      <!-- same pose as the world->camera_link static TF in gazebo.launch.py -->
      <pose>0.981 -0.05 1.351 0 0.9599 3.1416</pose>
      <link name="camera_link">
        <sensor name="camera" type="depth">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>5.0</far>
            </clip>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <remapping>camera/image_raw:=/camera/color/image_raw</remapping>
              <remapping>camera/camera_info:=/camera/color/camera_info</remapping>
              <remapping>camera/depth/image_raw:=/camera/aligned_depth_to_color/image_raw</remapping>
            </ros>
            <camera_name>camera</camera_name>
            <frame_name>camera_color_optical_frame</frame_name>
            <min_depth>0.1</min_depth>
            <max_depth>5.0</max_depth>
          </plugin>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
