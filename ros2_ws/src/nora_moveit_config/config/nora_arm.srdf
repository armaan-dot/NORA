<?xml version="1.0"?>
<!--
  NORA arm: semantic description for MoveIt 2. Matches nora_description/urdf/nora_arm.urdf.xacro.
-->
<robot name="nora_arm">

  <!-- 6-DOF arm. MoveIt plans for grasp_link, the point between the finger pads. -->
  <group name="arm">
    <chain base_link="base_link" tip_link="grasp_link" />
  </group>

  <group name="gripper">
    <joint name="gripper_joint" />
    <joint name="gripper_mimic_joint" />
  </group>

  <!-- Home: gripper pointing straight down, about 0.20 m above the table at x = 0.69 m. -->
  <group_state name="home" group="arm">
    <joint name="shoulder_pan_joint" value="0.0" />
    <joint name="shoulder_lift_joint" value="0.5" />
    <joint name="elbow_joint" value="1.3" />
    <joint name="wrist_1_joint" value="-0.2292" />
    <joint name="wrist_2_joint" value="-1.5708" />
    <joint name="wrist_3_joint" value="0.0" />
  </group_state>

  <!-- All joints at zero: arm pointing straight up. -->
  <group_state name="zeros" group="arm">
    <joint name="shoulder_pan_joint" value="0.0" />
    <joint name="shoulder_lift_joint" value="0.0" />
    <joint name="elbow_joint" value="0.0" />
    <joint name="wrist_1_joint" value="0.0" />
    <joint name="wrist_2_joint" value="0.0" />
    <joint name="wrist_3_joint" value="0.0" />
  </group_state>

  <!-- gripper_joint is the travel of one finger from the centre line. -->
  <group_state name="open" group="gripper">
    <joint name="gripper_joint" value="0.05" />
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="gripper_joint" value="0.0" />
  </group_state>

  <end_effector name="gripper_eef" parent_link="tool0" group="gripper" parent_group="arm" />

  <!-- Self-collision pairs that never need checking -->
  <disable_collisions link1="base_link"         link2="shoulder_link"     reason="Adjacent" />
  <disable_collisions link1="base_link"         link2="upper_arm_link"    reason="Never" />
  <disable_collisions link1="shoulder_link"     link2="upper_arm_link"    reason="Adjacent" />
  <disable_collisions link1="upper_arm_link"    link2="forearm_link"      reason="Adjacent" />
  <disable_collisions link1="forearm_link"      link2="wrist_1_link"      reason="Adjacent" />
  <disable_collisions link1="forearm_link"      link2="wrist_2_link"      reason="Never" />
  <disable_collisions link1="wrist_1_link"      link2="wrist_2_link"      reason="Adjacent" />
  <disable_collisions link1="wrist_1_link"      link2="wrist_3_link"      reason="Never" />
  <disable_collisions link1="wrist_2_link"      link2="wrist_3_link"      reason="Adjacent" />
  <disable_collisions link1="wrist_2_link"      link2="gripper_link"      reason="Never" />
  <disable_collisions link1="wrist_3_link"      link2="gripper_link"      reason="Adjacent" />
  <disable_collisions link1="wrist_3_link"      link2="left_finger_link"  reason="Never" />
  <disable_collisions link1="wrist_3_link"      link2="right_finger_link" reason="Never" />
  <disable_collisions link1="gripper_link"      link2="left_finger_link"  reason="Adjacent" />
  <disable_collisions link1="gripper_link"      link2="right_finger_link" reason="Adjacent" />
  <disable_collisions link1="left_finger_link"  link2="right_finger_link" reason="Default" />

</robot>
