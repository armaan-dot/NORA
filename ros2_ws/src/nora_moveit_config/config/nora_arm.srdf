<?xml version="1.0"?>
<!--
  NORA Arm — Semantic Robot Description Format (SRDF)
  Matches nora_description/urdf/nora_arm.urdf.xacro (same kinematics as the
  web simulator). The arm plans for the tcp frame between the finger pads.
-->
<robot name="nora_arm">

  <!-- ================================================================
       PLANNING GROUPS
       ================================================================ -->

  <!-- 6-DOF arm group, IK tip at the tcp -->
  <group name="arm">
    <chain base_link="base_link" tip_link="tcp" />
  </group>

  <!-- Parallel-jaw gripper; gripper_joint = pad-face gap in metres, fingers mimic it -->
  <group name="gripper">
    <link name="gripper_link" />
    <link name="gripper_driver_link" />
    <link name="left_finger_link" />
    <link name="right_finger_link" />
  </group>

  <!-- ================================================================
       GROUP STATES (named configurations)
       ================================================================ -->

  <!-- Home: same as the web simulator, tool pointing down ~0.36 m above the table -->
  <group_state name="home" group="arm">
    <joint name="joint1" value="-0.37" />
    <joint name="joint2" value="-0.35" />
    <joint name="joint3" value="1.9" />
    <joint name="joint4" value="0.02" />
    <joint name="joint5" value="-1.5708" />
    <joint name="joint6" value="0" />
  </group_state>

  <!-- Gripper open / closed reference states (pad-face gap, m) -->
  <group_state name="open" group="gripper">
    <joint name="gripper_joint" value="0.085" />
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="gripper_joint" value="0.0" />
  </group_state>

  <!-- ================================================================
       END-EFFECTORS
       ================================================================ -->
  <end_effector name="gripper_eef"
                parent_link="tcp"
                group="gripper"
                parent_group="arm" />

  <!-- ================================================================
       PASSIVE JOINTS (not commanded by MoveIt)
       ================================================================ -->
  <!-- <passive_joint name="..." /> -->

  <!-- ================================================================
       COLLISION PAIRS — disable self-collision for adjacent links
       ================================================================ -->
  <disable_collisions link1="base_link"  link2="link1"  reason="Adjacent" />
  <disable_collisions link1="link1"      link2="link2"  reason="Adjacent" />
  <disable_collisions link1="link2"      link2="link3"  reason="Adjacent" />
  <disable_collisions link1="link3"      link2="link4"  reason="Adjacent" />
  <disable_collisions link1="link4"      link2="link5"  reason="Adjacent" />
  <disable_collisions link1="link5"      link2="link6"  reason="Adjacent" />
  <disable_collisions link1="link6"      link2="gripper_link" reason="Adjacent" />
  <disable_collisions link1="gripper_link" link2="left_finger_link"  reason="Adjacent" />
  <disable_collisions link1="gripper_link" link2="right_finger_link" reason="Adjacent" />
  <!-- finger collision boxes overlap when the pad gap is under 5 mm -->
  <disable_collisions link1="left_finger_link" link2="right_finger_link" reason="Adjacent" />

</robot>
