<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nora_affordance</name>
  <version>0.1.0</version>
  <description>
    SayCan-inspired affordance scoring pipeline for NORA.
    Scores candidate skills by usefulness (LLM) and feasibility (IK, collision, object state).
  </description>
  <maintainer email="nora@example.com">NORA Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS 2 runtime deps -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nora_interfaces</exec_depend>

  <!-- Local workspace dep (must be built first) -->
  <!-- NOTE: nora_core is a local package in this workspace, not yet on rosdep -->
  <exec_depend>nora_core</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
