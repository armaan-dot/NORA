<?xml version="1.0" encoding="utf-8"?>
<!--
  materials.xacro — shared material definitions for the NORA arm.
  Include this file at the top of any xacro that needs arm materials.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Silver / metallic links -->
  <material name="silver">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>

  <!-- Dark grey structural parts -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <!-- Orange gripper accent -->
  <material name="orange">
    <color rgba="1.0 0.45 0.0 1.0"/>
  </material>

  <!-- White for labels / sensors -->
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <!-- Arm and gripper colours, same as the web simulator's nora_arm.urdf -->
  <material name="ur_aluminium"><color rgba="0.80 0.82 0.84 1.0"/></material>
  <material name="ur_cap"><color rgba="0.45 0.62 0.80 1.0"/></material>
  <material name="ur_seal"><color rgba="0.10 0.11 0.12 1.0"/></material>
  <material name="steel"><color rgba="0.55 0.57 0.60 1.0"/></material>
  <material name="gripper_body"><color rgba="0.16 0.17 0.19 1.0"/></material>
  <material name="gripper_pad"><color rgba="0.06 0.06 0.07 1.0"/></material>

</robot>
