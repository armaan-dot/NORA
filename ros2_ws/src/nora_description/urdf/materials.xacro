<?xml version="1.0" encoding="utf-8"?>
<!--
  materials.xacro — shared material definitions for the NORA arm.
  Include this file at the top of any xacro that needs arm materials.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Silver / metallic links -->
  <material name="silver">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>

  <!-- Dark grey structural parts -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <!-- Orange gripper accent -->
  <material name="orange">
    <color rgba="1.0 0.45 0.0 1.0"/>
  </material>

  <!-- White for labels / sensors -->
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

</robot>
