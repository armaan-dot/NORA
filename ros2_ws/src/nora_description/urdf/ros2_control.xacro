<?xml version="1.0" encoding="utf-8"?>
<!--
  ros2_control.xacro — ros2_control hardware interface for UR5e manipulator.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="nora_ros2_control" params="name sim_gazebo:=false">

    <ros2_control name="${name}" type="system">

      <!-- ----------------------------------------------------------------
           Hardware plugin: Gazebo physics, or mock hardware without Gazebo.
           For a real arm, put its ros2_control driver plugin here; nothing else changes.
      ---------------------------------------------------------------- -->
      <hardware>
        <xacro:if value="${sim_gazebo}">
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </xacro:if>
        <xacro:unless value="${sim_gazebo}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:unless>
      </hardware>

      <!-- ----------------------------------------------------------------
           UR5e 6-DOF Arm Joints
      ---------------------------------------------------------------- -->
      <joint name="shoulder_pan_joint">
        <command_interface name="position">
          <param name="min">${-2*pi}</param>
          <param name="max">${2*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="shoulder_lift_joint">
        <command_interface name="position">
          <param name="min">${-2*pi}</param>
          <param name="max">${2*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.5</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="elbow_joint">
        <command_interface name="position">
          <param name="min">${-2*pi}</param>
          <param name="max">${2*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">1.3</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="wrist_1_joint">
        <command_interface name="position">
          <param name="min">${-2*pi}</param>
          <param name="max">${2*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">-0.2292</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="wrist_2_joint">
        <command_interface name="position">
          <param name="min">${-2*pi}</param>
          <param name="max">${2*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">-1.5708</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="wrist_3_joint">
        <command_interface name="position">
          <param name="min">${-2*pi}</param>
          <param name="max">${2*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <!-- ----------------------------------------------------------------
           Gripper Joint
      ---------------------------------------------------------------- -->
      <joint name="gripper_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.05</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.05</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="gripper_mimic_joint">
        <param name="mimic">gripper_joint</param>
        <param name="multiplier">1</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>

