<?xml version="1.0" encoding="utf-8"?>
<!--
  nora_arm.urdf.xacro — Universal Robots UR5e 6-DOF Robotic Manipulator with Gripper.
  
  Kinematic Chain:
    world -> base_link
          -> shoulder_link   (shoulder_pan_joint,  Z-axis yaw)
          -> upper_arm_link   (shoulder_lift_joint, Y-axis pitch)
          -> forearm_link     (elbow_joint,         Y-axis pitch)
          -> wrist_1_link     (wrist_1_joint,       Y-axis pitch)
          -> wrist_2_link     (wrist_2_joint,       Z-axis yaw)
          -> wrist_3_link     (wrist_3_joint,       Y-axis pitch)
          -> flange -> tool0 -> gripper_link (gripper_joint)

  Specifications (UR5e Official):
    Reach:              850 mm (0.85 m)
    Payload:            5.0 kg
    Total Arm Mass:     ~20.6 kg
    Joint Velocities:   3.14 rad/s (joints 1-3), 6.28 rad/s (joints 4-6)
-->
<robot name="nora_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================================================================
       Includes
  ==================================================================== -->
  <!-- true: joints are driven by Gazebo (gazebo_ros2_control). false: ros2_control mock hardware. -->
  <xacro:arg name="sim_gazebo" default="false"/>
  <!-- true: Gazebo renders the wrist RGB-D camera (needs working OpenGL). Perception depends on it. -->
  <xacro:arg name="sim_camera" default="true"/>

  <xacro:include filename="$(find nora_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find nora_description)/urdf/ros2_control.xacro"/>

  <!-- ===================================================================
       UR5e Kinematic & Dynamic Parameters
  ==================================================================== -->
  <xacro:property name="d1" value="0.1625"/>   <!-- Base to shoulder Z -->
  <xacro:property name="a2" value="0.4250"/>   <!-- Upper arm length -->
  <xacro:property name="a3" value="0.3922"/>   <!-- Forearm length -->
  <xacro:property name="d4" value="0.1333"/>   <!-- Wrist 1 offset Y -->
  <xacro:property name="d5" value="0.0997"/>   <!-- Wrist 2 offset Z -->
  <xacro:property name="d6" value="0.0996"/>   <!-- Wrist 3 offset Y -->

  <!-- Joint limits -->
  <xacro:property name="joint_lower"    value="${-2*pi}"/>
  <xacro:property name="joint_upper"    value="${2*pi}"/>
  <xacro:property name="joint_vel_arm"  value="3.14159"/>  <!-- 180 deg/s -->
  <xacro:property name="joint_vel_wri"  value="6.28318"/>  <!-- 360 deg/s -->
  <xacro:property name="joint_eff_arm"  value="150.0"/>
  <xacro:property name="joint_eff_wri"  value="28.0"/>

  <!-- Helper for box/cylinder inertia -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r + h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r + h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y + z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x + z*z)/12}" iyz="0"
               izz="${m*(x*x + y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================================================================
       World & Base Link
  ==================================================================== -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- base_link: UR5e cylindrical base -->
  <link name="base_link">
    <xacro:cylinder_inertia m="4.0" r="0.075" h="0.1625"/>
    <visual>
      <origin xyz="0 0 ${d1/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.075" length="${d1}"/></geometry>
      <material name="ur_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${d1/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.075" length="${d1}"/></geometry>
    </collision>
  </link>

  <!-- ===================================================================
       Joint 1: shoulder_pan_joint (Yaw)
  ==================================================================== -->
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child  link="shoulder_link"/>
    <origin xyz="0 0 ${d1}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${joint_lower}" upper="${joint_upper}"
           effort="${joint_eff_arm}" velocity="${joint_vel_arm}"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="shoulder_link">
    <xacro:cylinder_inertia m="3.7" r="0.065" h="0.16"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.065" length="0.16"/></geometry>
      <material name="ur_blue"/>
    </visual>
    <visual>
      <origin xyz="0 0.05 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="0.06" length="0.12"/></geometry>
      <material name="ur_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.065" length="0.16"/></geometry>
    </collision>
  </link>

  <!-- ===================================================================
       Joint 2: shoulder_lift_joint (Pitch)
  ==================================================================== -->
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child  link="upper_arm_link"/>
    <origin xyz="0 ${d4} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${joint_lower}" upper="${joint_upper}"
           effort="${joint_eff_arm}" velocity="${joint_vel_arm}"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="upper_arm_link">
    <xacro:cylinder_inertia m="8.39" r="0.055" h="${a2}"/>
    <!-- Upper arm main tube -->
    <visual>
      <origin xyz="0 0 ${a2/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="${a2}"/></geometry>
      <material name="ur_grey"/>
    </visual>
    <!-- Upper arm joint cap -->
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="0.06" length="0.12"/></geometry>
      <material name="ur_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${a2/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="${a2}"/></geometry>
    </collision>
  </link>

  <!-- ===================================================================
       Joint 3: elbow_joint (Pitch)
  ==================================================================== -->
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child  link="forearm_link"/>
    <origin xyz="0 -0.1197 ${a2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${joint_lower}" upper="${joint_upper}"
           effort="${joint_eff_arm}" velocity="${joint_vel_arm}"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="forearm_link">
    <xacro:cylinder_inertia m="2.275" r="0.045" h="${a3}"/>
    <!-- Forearm tube -->
    <visual>
      <origin xyz="0 0 ${a3/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="${a3}"/></geometry>
      <material name="ur_grey"/>
    </visual>
    <!-- Elbow joint cap -->
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="0.055" length="0.11"/></geometry>
      <material name="ur_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${a3/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="${a3}"/></geometry>
    </collision>
  </link>

  <!-- ===================================================================
       Joint 4: wrist_1_joint (Pitch)
  ==================================================================== -->
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child  link="wrist_1_link"/>
    <origin xyz="0 0 ${a3}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${joint_lower}" upper="${joint_upper}"
           effort="${joint_eff_wri}" velocity="${joint_vel_wri}"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="wrist_1_link">
    <xacro:cylinder_inertia m="1.219" r="0.04" h="${d5}"/>
    <visual>
      <origin xyz="0 ${d5/2} 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="0.04" length="${d5}"/></geometry>
      <material name="ur_blue"/>
    </visual>
    <collision>
      <origin xyz="0 ${d5/2} 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="0.04" length="${d5}"/></geometry>
    </collision>
  </link>

  <!-- ===================================================================
       Joint 5: wrist_2_joint (Yaw)
  ==================================================================== -->
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child  link="wrist_2_link"/>
    <origin xyz="0 ${d5} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${joint_lower}" upper="${joint_upper}"
           effort="${joint_eff_wri}" velocity="${joint_vel_wri}"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="wrist_2_link">
    <xacro:cylinder_inertia m="1.219" r="0.038" h="${d5}"/>
    <visual>
      <origin xyz="0 0 ${d5/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.038" length="${d5}"/></geometry>
      <material name="ur_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${d5/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.038" length="${d5}"/></geometry>
    </collision>
  </link>

  <!-- ===================================================================
       Joint 6: wrist_3_joint (Pitch)
  ==================================================================== -->
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child  link="wrist_3_link"/>
    <origin xyz="0 0 ${d5}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${joint_lower}" upper="${joint_upper}"
           effort="${joint_eff_wri}" velocity="${joint_vel_wri}"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="wrist_3_link">
    <xacro:cylinder_inertia m="0.188" r="0.035" h="${d6}"/>
    <visual>
      <origin xyz="0 ${d6/2} 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="0.035" length="${d6}"/></geometry>
      <material name="ur_blue"/>
    </visual>
    <collision>
      <origin xyz="0 ${d6/2} 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="0.035" length="${d6}"/></geometry>
    </collision>
  </link>

  <!-- ===================================================================
       Tool Flange & tool0 Frame
  ==================================================================== -->
  <joint name="wrist_3_to_flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child  link="flange"/>
    <origin xyz="0 ${d6} 0" rpy="0 0 0"/>
  </joint>

  <link name="flange">
    <visual>
      <origin xyz="0 0.005 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="0.035" length="0.01"/></geometry>
      <material name="ur_dark"/>
    </visual>
  </link>

  <joint name="flange_to_tool0" type="fixed">
    <parent link="flange"/>
    <child  link="tool0"/>
    <origin xyz="0 0.01 0" rpy="${-pi/2} 0 0"/>
  </joint>

  <link name="tool0"/>

  <!-- ===================================================================
       End-Effector / Parallel Gripper
  ==================================================================== -->
  <!-- Palm, fixed to the flange. gripper_link keeps its old frame. -->
  <joint name="tool0_to_gripper" type="fixed">
    <parent link="tool0"/>
    <child  link="gripper_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <link name="gripper_link">
    <xacro:box_inertia m="0.3" x="0.05" y="0.13" z="0.04"/>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.05 0.13 0.04"/></geometry>
      <material name="ur_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.05 0.13 0.04"/></geometry>
    </collision>
  </link>

  <!-- Two fingers. gripper_joint is the travel of ONE finger from the centre line:
       0 = closed (pads touching), 0.05 = open (0.10 m between the pads). The other finger mirrors it. -->
  <xacro:macro name="finger" params="name joint side *extra">
    <joint name="${joint}" type="prismatic">
      <parent link="gripper_link"/>
      <child  link="${name}"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <axis xyz="0 ${side} 0"/>
      <limit lower="0.0" upper="0.05" effort="50.0" velocity="0.2"/>
      <xacro:insert_block name="extra"/>
    </joint>
    <link name="${name}">
      <inertial>
        <origin xyz="0 ${side*0.006} 0.03" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="2e-5" ixy="0" ixz="0" iyy="2e-5" iyz="0" izz="5e-6"/>
      </inertial>
      <visual>
        <origin xyz="0 ${side*0.006} 0.03" rpy="0 0 0"/>
        <geometry><box size="0.025 0.012 0.06"/></geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 ${side*0.006} 0.03" rpy="0 0 0"/>
        <geometry><box size="0.025 0.012 0.06"/></geometry>
      </collision>
    </link>
    <gazebo reference="${name}">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <kp>100000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.1</maxVel>
      <material>Gazebo/Orange</material>
    </gazebo>
  </xacro:macro>

  <xacro:finger name="left_finger_link" joint="gripper_joint" side="1">
    <dynamics damping="1.0" friction="0.0"/>
  </xacro:finger>
  <xacro:finger name="right_finger_link" joint="gripper_mimic_joint" side="-1">
    <mimic joint="gripper_joint" multiplier="1" offset="0"/>
  </xacro:finger>

  <!-- Grasp point: on the centre line, 15 mm above the fingertips. MoveIt plans for this frame. -->
  <joint name="gripper_to_grasp" type="fixed">
    <parent link="gripper_link"/>
    <child  link="grasp_link"/>
    <origin xyz="0 0 0.085" rpy="0 0 0"/>
  </joint>
  <link name="grasp_link"/>

  <!-- ===================================================================
       Eye-in-Hand RGB-D Camera (Intel RealSense D435) for Foxglove & ROS 2
  ==================================================================== -->
  <joint name="camera_mount_joint" type="fixed">
    <parent link="gripper_link"/>
    <child  link="camera_link"/>
    <origin xyz="0.0375 0 0.02" rpy="0 0 ${pi/2}"/>
  </joint>

  <link name="camera_link">
    <xacro:box_inertia m="0.072" x="0.09" y="0.025" z="0.025"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.09 0.025 0.025"/></geometry>
      <material name="ur_dark"/>
    </visual>
  </link>

  <joint name="camera_color_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_color_frame"/>
    <origin xyz="0.015 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_color_frame"/>

  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_color_frame"/>
    <child  link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="camera_color_optical_frame"/>

  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_depth_frame"/>
    <origin xyz="-0.015 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_depth_frame"/>

  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child  link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="camera_depth_optical_frame"/>

  <!-- ===================================================================
       Backwards Compatibility Aliases (link1..link6)
  ==================================================================== -->
  <joint name="alias_link1" type="fixed">
    <parent link="shoulder_link"/>
    <child  link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="link1"/>

  <joint name="alias_link6" type="fixed">
    <parent link="wrist_3_link"/>
    <child  link="link6"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="link6"/>

  <!-- ===================================================================
       ros2_control hardware interface
  ==================================================================== -->
  <xacro:nora_ros2_control name="UR5eSystem" sim_gazebo="$(arg sim_gazebo)"/>

  <!-- ===================================================================
       Wrist camera frame that looks along the fingers (Gazebo cameras look along +X)
  ==================================================================== -->
  <joint name="camera_sim_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_sim_frame"/>
    <origin xyz="0 0 0" rpy="0 ${-pi/2} 0"/>
  </joint>
  <link name="camera_sim_frame"/>
  <joint name="camera_sim_optical_joint" type="fixed">
    <parent link="camera_sim_frame"/>
    <child  link="camera_sim_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="camera_sim_optical_frame"/>

  <!-- ===================================================================
       Gazebo Classic: ros2_control plugin and the wrist camera sensor (sim_gazebo:=true only)
  ==================================================================== -->
  <xacro:if value="$(arg sim_gazebo)">
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <parameters>$(find nora_control)/config/ros2_controllers.yaml</parameters>
      </plugin>
    </gazebo>

    <xacro:if value="$(arg sim_camera)">
    <gazebo reference="camera_sim_frame">
      <sensor type="depth" name="wrist_camera">
        <update_rate>5</update_rate>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>5.0</far></clip>
        </camera>
        <plugin name="wrist_camera_controller" filename="libgazebo_ros_camera.so">
          <ros><namespace>/camera</namespace></ros>
          <camera_name>color</camera_name>
          <frame_name>camera_sim_optical_frame</frame_name>
          <min_depth>0.02</min_depth>
          <max_depth>3.0</max_depth>
        </plugin>
      </sensor>
    </gazebo>
    </xacro:if>
  </xacro:if>

</robot>

