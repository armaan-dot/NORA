<?xml version="1.0" encoding="utf-8"?>
<!--
  nora_arm.urdf.xacro
  UR5e-style 6-DOF NORA arm with a parallel-jaw gripper, primitive geometry only.
  Links, joints, limits, visuals and collisions are identical to the web
  simulator's frontend/public/nora_arm.urdf. Inertials, the world link and the
  tcp frame are added here for ROS / Gazebo / MoveIt.
    world -> base_link -> link1 .. link6 -> gripper_link -> tcp
  gripper_joint = distance between the finger pad faces (0 closed, 0.085 m open).
  Top-down tool pose: joint2 + joint3 + joint4 = pi/2 and joint5 = -pi/2.
-->
<robot name="nora_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- true: Gazebo Classic hardware (gazebo_ros2_control); false: mock hardware -->
  <xacro:arg name="use_gazebo" default="false"/>

  <!-- ===================================================================
       Includes
  ==================================================================== -->
  <xacro:include filename="$(find nora_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find nora_description)/urdf/ros2_control.xacro"/>

  <!-- Simple diagonal inertia helper -->
  <xacro:macro name="simple_inertia" params="mass ixx iyy izz xyz:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${ixx}" ixy="0.0" ixz="0.0"
               iyy="${iyy}" iyz="0.0"
               izz="${izz}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================================================================
       World / Base (base_link sits on the table top, 0.45 m above the floor)
  ==================================================================== -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0.45" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <xacro:simple_inertia mass="4.0" ixx="0.0115" iyy="0.0115" izz="0.0181" xyz="0 0 0.043"/>
    <!-- mounting plate -->
    <visual>
      <origin xyz="0 0 0.006" rpy="0 0 0"/>
      <geometry><cylinder radius="0.095" length="0.012"/></geometry>
      <material name="ur_seal"/>
    </visual>
    <!-- base housing -->
    <visual>
      <origin xyz="0 0 0.046" rpy="0 0 0"/>
      <geometry><cylinder radius="0.075" length="0.068"/></geometry>
      <material name="ur_aluminium"/>
    </visual>
    <!-- base joint cap ring -->
    <visual>
      <origin xyz="0 0 0.083" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0755" length="0.006"/></geometry>
      <material name="ur_cap"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.043" rpy="0 0 0"/>
      <geometry><cylinder radius="0.095" length="0.086"/></geometry>
    </collision>
  </link>

  <!-- ===================================================================
       Shoulder pan (link1)
  ==================================================================== -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child  link="link1"/>
    <origin xyz="0 0 0.086" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="150.0" velocity="3.14"/>
  </joint>

  <link name="link1">
    <xacro:simple_inertia mass="3.761" ixx="0.0126" iyy="0.0126" izz="0.0106" xyz="0 0.01 0.06"/>
    <!-- seal ring between base and shoulder -->
    <visual>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry><cylinder radius="0.076" length="0.004"/></geometry>
      <material name="ur_seal"/>
    </visual>
    <!-- vertical shoulder drum -->
    <visual>
      <origin xyz="0 0 0.0383" rpy="0 0 0"/>
      <geometry><cylinder radius="0.075" length="0.0685"/></geometry>
      <material name="ur_aluminium"/>
    </visual>
    <!-- horizontal shoulder-lift motor drum -->
    <visual>
      <origin xyz="0 0.020 0.0765" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.075" length="0.12"/></geometry>
      <material name="ur_aluminium"/>
    </visual>
    <!-- shoulder-lift end cap -->
    <visual>
      <origin xyz="0 -0.045 0.0765" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0755" length="0.010"/></geometry>
      <material name="ur_cap"/>
    </visual>
    <collision>
      <origin xyz="0 0.020 0.0765" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.075" length="0.13"/></geometry>
    </collision>
  </link>

  <!-- ===================================================================
       Shoulder lift (link2, upper arm)
  ==================================================================== -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child  link="link2"/>
    <origin xyz="0 0 0.0765" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="150.0" velocity="3.14"/>
  </joint>

  <link name="link2">
    <xacro:simple_inertia mass="8.058" ixx="0.210" iyy="0.210" izz="0.0145" xyz="0 0.120 0.2125"/>
    <!-- seal ring at shoulder -->
    <visual>
      <origin xyz="0 0.0825 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.076" length="0.005"/></geometry>
      <material name="ur_seal"/>
    </visual>
    <!-- outer shoulder drum -->
    <visual>
      <origin xyz="0 0.120 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.075" length="0.070"/></geometry>
      <material name="ur_aluminium"/>
    </visual>
    <visual>
      <origin xyz="0 0.159 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0755" length="0.008"/></geometry>
      <material name="ur_cap"/>
    </visual>
    <!-- upper arm tube -->
    <visual>
      <origin xyz="0 0.120 0.2125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.054" length="0.33"/></geometry>
      <material name="ur_aluminium"/>
    </visual>
    <!-- elbow drum (outer half) -->
    <visual>
      <origin xyz="0 0.095 0.425" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.060" length="0.120"/></geometry>
      <material name="ur_aluminium"/>
    </visual>
    <visual>
      <origin xyz="0 0.159 0.425" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0605" length="0.008"/></geometry>
      <material name="ur_cap"/>
    </visual>
    <collision>
      <origin xyz="0 0.120 0.2125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.55"/></geometry>
    </collision>
  </link>

  <!-- ===================================================================
       Elbow (link3, forearm)
  ==================================================================== -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child  link="link3"/>
    <origin xyz="0 0 0.425" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="150.0" velocity="3.14"/>
  </joint>

  <link name="link3">
    <xacro:simple_inertia mass="2.846" ixx="0.0561" iyy="0.0561" izz="0.00288" xyz="0 0 0.196"/>
    <!-- seal ring at elbow -->
    <visual>
      <origin xyz="0 0.0325 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.061" length="0.005"/></geometry>
      <material name="ur_seal"/>
    </visual>
    <!-- inner elbow drum -->
    <visual>
      <origin xyz="0 0.0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.060" length="0.060"/></geometry>
      <material name="ur_aluminium"/>
    </visual>
    <visual>
      <origin xyz="0 -0.034 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0605" length="0.008"/></geometry>
      <material name="ur_cap"/>
    </visual>
    <!-- forearm tube -->
    <visual>
      <origin xyz="0 0 0.196" rpy="0 0 0"/>
      <geometry><cylinder radius="0.040" length="0.30"/></geometry>
      <material name="ur_aluminium"/>
    </visual>
    <!-- wrist 1 drum (inner half) -->
    <visual>
      <origin xyz="0 0.040 0.3922" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.100"/></geometry>
      <material name="ur_aluminium"/>
    </visual>
    <visual>
      <origin xyz="0 -0.0135 0.3922" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0455" length="0.007"/></geometry>
      <material name="ur_cap"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.196" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.48"/></geometry>
    </collision>
  </link>

  <!-- ===================================================================
       Wrist 1 (link4)
  ==================================================================== -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child  link="link4"/>
    <origin xyz="0 0 0.3922" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="28.0" velocity="3.14"/>
  </joint>

  <link name="link4">
    <xacro:simple_inertia mass="1.37" ixx="0.00326" iyy="0.00139" izz="0.00326" xyz="0 0.11 0.02"/>
    <visual>
      <origin xyz="0 0.0925 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.046" length="0.005"/></geometry>
      <material name="ur_seal"/>
    </visual>
    <!-- outer wrist 1 drum -->
    <visual>
      <origin xyz="0 0.1140 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.039"/></geometry>
      <material name="ur_aluminium"/>
    </visual>
    <!-- rounded elbow of the L-shaped wrist housing -->
    <visual>
      <origin xyz="0 0.1333 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="ur_aluminium"/>
    </visual>
    <!-- riser toward wrist 2 -->
    <visual>
      <origin xyz="0 0.1333 0.040" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.080"/></geometry>
      <material name="ur_aluminium"/>
    </visual>
    <collision>
      <origin xyz="0 0.1333 0.040" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.10"/></geometry>
    </collision>
  </link>

  <!-- ===================================================================
       Wrist 2 (link5)
  ==================================================================== -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child  link="link5"/>
    <origin xyz="0 0.1333 0.0997" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="28.0" velocity="3.14"/>
  </joint>

  <link name="link5">
    <xacro:simple_inertia mass="1.3" ixx="0.00154" iyy="0.00132" izz="0.00154" xyz="0 0.02 0"/>
    <visual>
      <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
      <geometry><cylinder radius="0.046" length="0.005"/></geometry>
      <material name="ur_seal"/>
    </visual>
    <!-- wrist 2 drum -->
    <visual>
      <origin xyz="0 0 0.006" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.042"/></geometry>
      <material name="ur_aluminium"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.0305" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0455" length="0.007"/></geometry>
      <material name="ur_cap"/>
    </visual>
    <!-- branch toward wrist 3 -->
    <visual>
      <origin xyz="0 0.030 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.060"/></geometry>
      <material name="ur_aluminium"/>
    </visual>
    <collision>
      <origin xyz="0 0.030 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.09"/></geometry>
    </collision>
  </link>

  <!-- ===================================================================
       Wrist 3 / tool flange (link6)
  ==================================================================== -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child  link="link6"/>
    <origin xyz="0 0.0596 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="28.0" velocity="3.14"/>
  </joint>

  <link name="link6">
    <xacro:simple_inertia mass="0.365" ixx="0.000233" iyy="0.000233" izz="0.000370" xyz="0 0 0.02"/>
    <visual>
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.046" length="0.005"/></geometry>
      <material name="ur_seal"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.018" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.026"/></geometry>
      <material name="ur_aluminium"/>
    </visual>
    <!-- ISO tool flange -->
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0315" length="0.008"/></geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.04"/></geometry>
    </collision>
  </link>

  <!-- ===================================================================
       Parallel-jaw gripper
  ==================================================================== -->
  <joint name="gripper_mount_joint" type="fixed">
    <parent link="link6"/>
    <child  link="gripper_link"/>
    <origin xyz="0 0 0.039" rpy="0 0 0"/>
  </joint>

  <link name="gripper_link">
    <xacro:simple_inertia mass="0.925" ixx="0.000643" iyy="0.00143" izz="0.00108" xyz="0 0 0.045"/>
    <!-- coupling -->
    <visual>
      <origin xyz="0 0 0.006" rpy="0 0 0"/>
      <geometry><cylinder radius="0.034" length="0.012"/></geometry>
      <material name="steel"/>
    </visual>
    <!-- gripper body -->
    <visual>
      <origin xyz="0 0 0.0445" rpy="0 0 0"/>
      <geometry><box size="0.078 0.044 0.065"/></geometry>
      <material name="gripper_body"/>
    </visual>
    <!-- finger guide rail -->
    <visual>
      <origin xyz="0 0 0.0795" rpy="0 0 0"/>
      <geometry><box size="0.110 0.030 0.005"/></geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.040" rpy="0 0 0"/>
      <geometry><box size="0.11 0.044 0.08"/></geometry>
    </collision>
  </link>

  <!-- Tool centre point, between the finger pads -->
  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_link"/>
    <child  link="tcp"/>
    <origin xyz="0 0 0.115" rpy="0 0 0"/>
  </joint>
  <link name="tcp"/>

  <!-- Driver joint: value = total opening stroke. Fingers mimic it. -->
  <joint name="gripper_joint" type="prismatic">
    <parent link="gripper_link"/>
    <child  link="gripper_driver_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.085" effort="50.0" velocity="0.15"/>
  </joint>

  <link name="gripper_driver_link">
    <xacro:simple_inertia mass="0.01" ixx="1.0e-6" iyy="1.0e-6" izz="1.0e-6"/>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_link"/>
    <child  link="left_finger_link"/>
    <origin xyz="-0.0055 0 0.082" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.05" upper="0.0" effort="50.0" velocity="0.15"/>
    <mimic joint="gripper_joint" multiplier="-0.5" offset="0"/>
  </joint>

  <link name="left_finger_link">
    <xacro:simple_inertia mass="0.05" ixx="1.5e-5" iyy="1.23e-5" izz="4.82e-6" xyz="0 0 0.026"/>
    <visual>
      <origin xyz="-0.004 0 0.026" rpy="0 0 0"/>
      <geometry><box size="0.012 0.030 0.052"/></geometry>
      <material name="gripper_body"/>
    </visual>
    <visual>
      <origin xyz="0.0035 0 0.034" rpy="0 0 0"/>
      <geometry><box size="0.004 0.026 0.036"/></geometry>
      <material name="gripper_pad"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.026" rpy="0 0 0"/>
      <geometry><box size="0.016 0.030 0.052"/></geometry>
    </collision>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_link"/>
    <child  link="right_finger_link"/>
    <origin xyz="0.0055 0 0.082" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.05" effort="50.0" velocity="0.15"/>
    <mimic joint="gripper_joint" multiplier="0.5" offset="0"/>
  </joint>

  <link name="right_finger_link">
    <xacro:simple_inertia mass="0.05" ixx="1.5e-5" iyy="1.23e-5" izz="4.82e-6" xyz="0 0 0.026"/>
    <visual>
      <origin xyz="0.004 0 0.026" rpy="0 0 0"/>
      <geometry><box size="0.012 0.030 0.052"/></geometry>
      <material name="gripper_body"/>
    </visual>
    <visual>
      <origin xyz="-0.0035 0 0.034" rpy="0 0 0"/>
      <geometry><box size="0.004 0.026 0.036"/></geometry>
      <material name="gripper_pad"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.026" rpy="0 0 0"/>
      <geometry><box size="0.016 0.030 0.052"/></geometry>
    </collision>
  </link>

  <!-- ===================================================================
       ros2_control integration (defined in ros2_control.xacro)
  ==================================================================== -->
  <xacro:nora_ros2_control name="NorArmSystem" use_gazebo="$(arg use_gazebo)"/>

</robot>
