      "transforms": {
        "frame:world": { "visible": true },
        "frame:base_link": { "visible": true },
        "frame:shoulder_link": { "visible": false },
        "frame:upper_arm_link": { "visible": false },
        "frame:forearm_link": { "visible": false },
        "frame:wrist_1_link": { "visible": false },
        "frame:wrist_2_link": { "visible": false },
        "frame:wrist_3_link": { "visible": false },
        "frame:tool0": { "visible": true },
        "frame:gripper_link": { "visible": true }
      },
      "topics": {
        "/robot_description": {
          "visible": true
