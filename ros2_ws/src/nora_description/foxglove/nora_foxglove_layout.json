        "/tf_static": {
          "visible": true
        },
        "/visualization_marker": {
          "visible": true
        },
        "/visualization_marker_array": {
          "visible": true
        }
      },
      "layers": {
        "grid": {
          "layerId": "foxglove.Grid",
