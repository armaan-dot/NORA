        {
          "value": "/joint_states.position[0]",
          "enabled": true,
          "label": "Shoulder Pan (Yaw)",
          "color": "#e6194b"
        },
        {
          "value": "/joint_states.position[1]",
          "enabled": true,
          "label": "Shoulder Lift (Pitch)",
          "color": "#3cb44b"
        },
        {
          "value": "/joint_states.position[2]",
          "enabled": true,
          "label": "Elbow (Pitch)",
          "color": "#ffe119"
        },
        {
          "value": "/joint_states.position[3]",
          "enabled": true,
          "label": "Wrist 1 (Pitch)",
          "color": "#4363d8"
        },
        {
          "value": "/joint_states.position[4]",
          "enabled": true,
          "label": "Wrist 2 (Yaw)",
          "color": "#f58231"
        },
        {
          "value": "/joint_states.position[5]",
          "enabled": true,
          "label": "Wrist 3 (Pitch)",
          "color": "#911eb4"
        }
      ],
      "showLegend": true,
      "xAxisVal": "timestamp"
    },
    "Publish!intent_publisher": {
      "topic": "/nora/intent",
      "datatype": "std_msgs/msg/String",
      "buttonText": "Dispatch Intent to NORA",
      "buttonTooltip": "Publishes JSON Intent string to /nora/intent",
      "buttonColor": "#0088ff",
      "advancedView": true,
      "value": "{\n  \"data\": \"{\\\"action\\\": \\\"pick\\\", \\\"target_object\\\": \\\"red_cube\\\", \\\"target_location\\\": \\\"table\\\"}\"\n}"
    },
