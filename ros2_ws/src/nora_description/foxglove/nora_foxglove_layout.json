      "synchronize": false,
      "mode": "fit",
      "zoomPercentage": 100,
      "flipHorizontal": false,
      "flipVertical": false
    },
    "Plot!slam_motion_telemetry": {
      "title": "UR5e Kinematic & SLAM Trajectory Telemetry",
      "paths": [
        {
          "value": "/joint_states.position[0]",
          "enabled": true,
          "label": "Joint 1: Shoulder Pan (rad)",
          "color": "#38bdf8"
        },
        {
          "value": "/joint_states.position[1]",
          "enabled": true,
          "label": "Joint 2: Shoulder Lift (rad)",
          "color": "#4ade80"
        },
        {
          "value": "/joint_states.position[2]",
          "enabled": true,
          "label": "Joint 3: Elbow (rad)",
          "color": "#facc15"
        },
        {
          "value": "/joint_states.position[4]",
          "enabled": true,
          "label": "Joint 5: Wrist 2 (rad)",
          "color": "#f43f5e"
        },
        {
          "value": "/robot_pose.pose.position.y",
          "enabled": true,
          "label": "Camera Height Y (m)",
          "color": "#c084fc"
        }
      ],
      "showLegend": true,
      "xAxisVal": "timestamp"
    },
    "Publish!add_object_publisher": {
      "topic": "/nora/tabletop_objects/add",
