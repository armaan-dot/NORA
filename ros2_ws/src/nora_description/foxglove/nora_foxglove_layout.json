      "buttonColor": "#10b981",
      "advancedView": true,
      "value": "{\n  \"data\": \"{\\\"id\\\": \\\"scissors\\\", \\\"name\\\": \\\"Scissors\\\", \\\"shape\\\": \\\"scissors\\\", \\\"color\\\": \\\"#e11d48\\\", \\\"x\\\": 0.08, \\\"y\\\": 0.465, \\\"z\\\": 0.15}\"\n}"
    },
    "Publish!intent_publisher": {
      "topic": "/nora/intent",
      "datatype": "std_msgs/msg/String",
      "buttonText": "Dispatch Task to NORA",
      "buttonTooltip": "Publishes natural language robotic intent to /nora/intent",
      "buttonColor": "#0284c7",
      "advancedView": true,
      "value": "{\n  \"data\": \"{\\\"action\\\": \\\"pick\\\", \\\"target_object\\\": \\\"scissors\\\", \\\"target_location\\\": \\\"user\\\"}\"\n}"
    },
    "RawMessages!tabletop_objects": {
      "topicPath": "/nora/tabletop_objects",
